#!/bin/bash

terminal=false
while getopts ":t" opt; do
  case "$opt" in
    t) terminal=true ;;
    *)
      echo "Usage: $0 [-t]" >&2
      exit 2
      ;;
  esac
done
shift $((OPTIND - 1))

declare -A cmds
declare -a opts

function add_opt {
  cmds["$1"]="$2"
  opts+=( "$1" )
}

function idle-suspend-is-enabled {
  local profile action
  for profile in AC Battery LowBattery; do
    action="$(kreadconfig6 --file powerdevilrc --group "$profile" --group SuspendAndShutdown --key AutoSuspendAction --default 0)"
    if [ "$action" != "0" ]; then
      return 0
    fi
  done
  return 1
}

function toggle-idle-suspend {
  local profile action

  if idle-suspend-is-enabled; then
    for profile in AC Battery LowBattery; do
      action="$(kreadconfig6 --file powerdevilrc --group "$profile" --group SuspendAndShutdown --key AutoSuspendAction --default 0)"
      kwriteconfig6 --file quick-actionsrc --group IdleSuspendBackup --key "$profile" "$action"
      kwriteconfig6 --file powerdevilrc --group "$profile" --group SuspendAndShutdown --key AutoSuspendAction 0
    done
    notify "Automatic idle suspend disabled" "Your screen-off timeout is unchanged."
  else
    for profile in AC Battery LowBattery; do
      action="$(kreadconfig6 --file quick-actionsrc --group IdleSuspendBackup --key "$profile" --default 1)"
      kwriteconfig6 --file powerdevilrc --group "$profile" --group SuspendAndShutdown --key AutoSuspendAction "$action"
    done
    notify "Automatic idle suspend enabled"
  fi

  systemctl --user restart plasma-powerdevil.service
}

add_opt "Play/Pause" "playerctl play-pause"
add_opt "Switch sound to speakers" "switch-audio-output 'Pebble V3' && notify 'Switched to speakers'"
add_opt "Switch sound to headphones" "switch-audio-output 'Starship/Matisse HD Audio Controller Analog Stereo' && notify 'Switched to headphones'"
add_opt "Suspend system" "systemctl suspend"
add_opt "Allow Plex through Mullvad" "mullvad-exclude-plex"
add_opt "Allow Jellyfin through Mullvad" "mullvad-exclude-jellyfin"

if command -v kreadconfig6 >/dev/null && command -v kwriteconfig6 >/dev/null && command -v systemctl >/dev/null; then
  if idle-suspend-is-enabled; then
    add_opt "Disable automatic idle suspend (keep screen-off)" "toggle-idle-suspend"
  else
    add_opt "Enable automatic idle suspend" "toggle-idle-suspend"
  fi
fi

if command -v pulseaudio >/dev/null; then
  add_opt "Kill PulseAudio" "pulseaudio -k"
fi

if command -v openrgb >/dev/null && [ -d ~/.config/OpenRGB ]; then
  for profile in $(basename -s .orp ~/.config/OpenRGB/*.orp); do
    add_opt "openrgb profile: $profile" "openrgb -p $profile"
  done
fi

if curl -fsSL http://localhost:27003 >/dev/null; then
  openlinkhub_device_id="$(curl -s http://127.0.0.1:27003/api/device/ | jq -r '.device | keys | .[]' | head -n1)"
  for profile in off rainbow pastelrainbow spiralrainbow pastelspiralrainbow; do
    add_opt "openlinkhub rgb profile: $profile" "curl 'http://localhost:27003/api/color' --data-raw '{\"deviceId\": \"$openlinkhub_device_id\", \"channelId\": -1, \"channelIds\": [], \"profile\": \"$profile\"}'"
  done
fi

if command -v kscreen-doctor >/dev/null; then
  add_opt "Turn off screen" "kscreen-doctor --dpms off"
fi

function notify {
  command -v notify-send >/dev/null && notify-send "$@"
}

function switch-audio-output {
  local description="${1?description missing}"
  local name="$(pactl list sinks | grep "Description: $description" -B1 | head -n1 | awk '{print $2}')"
  if [ -z "$name" ]; then
    echo "could not find sink matching description '$description'" >&2
    return 1
  fi
  echo "$description"
  echo "$name"
  pactl set-default-sink "$name"
}

function mullvad-exclude-plex {
  local pids=0
  for pid in $(pgrep -f plexmediaserver); do
    mullvad split-tunnel add "$pid"
    (( pids++ ))
  done
  notify "Excluded $pids Plex PIDs from Mullvad"
}

function mullvad-exclude-jellyfin {
  local pids=0
  for pid in $(pgrep -f jellyfin); do
    mullvad split-tunnel add "$pid"
    (( pids++ ))
  done
  notify "Excluded $pids Jellyfin PIDs from Mullvad"
}

if "$terminal"; then
  printf 'Select an action:\n'
  for i in "${!opts[@]}"; do
    printf '%d) %s\n' "$((i + 1))" "${opts[i]}"
  done

  while true; do
    read -r -p 'Action number (blank to cancel): ' selection || exit 0
    [ -z "$selection" ] && exit 0

    if [[ "$selection" =~ ^[0-9]+$ ]] && (( selection >= 1 && selection <= ${#opts[@]} )); then
      action="${opts[selection - 1]}"
      break
    fi

    echo "Please enter a number from 1 to ${#opts[@]}." >&2
  done
elif [ "$XDG_SESSION_TYPE" = wayland ]; then
  action="$(printf '%s\n' "${opts[@]}" | wofi -d -M fuzzy -p action -L 4 -i)"
else
  action="$(printf '%s\n' "${opts[@]}" | rofi -dmenu -p action -l 6 -i)"
fi
cmd="${cmds["${action:-none}"]}"

if [ -z "$cmd" ]; then
  exit
fi

result="$(eval "$cmd" 2>&1)"
if [ $? != 0 ]; then
  if command -v notify-send >/dev/null; then
    notify-send -i error -u critical "Failed to execute action '$action'" "$result"
  else
    echo "Failed to execute action '$action': $result" >&2
    exit 1
  fi
fi
