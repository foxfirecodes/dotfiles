# Gitfox repository-aware values. The generated function above was renamed to
# _gfx_static; this wrapper calls it for ordinary Clap completion.
_gfx() {
  local kind previous current flag item value description
  previous="${words[CURRENT-1]}"
  current="${words[CURRENT]}"
  case "$previous" in
    --workspace) kind=workspace ;;
    --stack) kind=stack ;;
    --branch|--above|--below) kind=branch ;;
    --draft) kind=draft ;;
    --source|--base) kind=local-branch ;;
  esac
  if [[ -z "$kind" && "$current" == --*=* ]]; then
    flag="${current%%=*}"
    case "$flag" in
      --workspace) kind=workspace ;;
      --stack) kind=stack ;;
      --branch|--above|--below) kind=branch ;;
      --draft) kind=draft ;;
      --source|--base) kind=local-branch ;;
    esac
  fi
  if [[ -n "$kind" ]]; then
    # Keep the option prefix out of candidates.  Zsh then filters on and
    # reinserts the value portion while preserving `--flag=` in the buffer.
    [[ -n "$flag" ]] && compset -P '*\='
    local -a raw_candidates candidates
    raw_candidates=( ${(f)"$(gfx __complete "$kind")"} )
    candidates=()
    for item in $raw_candidates; do
      value="${item%%$'\t'*}"
      description="${item#*$'\t'}"
      [[ "$description" == "$item" ]] && description="$kind"
      candidates+=("$value:$description")
    done
    _describe -t values "$kind" candidates
  else
    _gfx_static "$@"
  fi
}
if [ "$funcstack[1]" = "_gfx" ]; then
  _gfx "$@"
else
  compdef _gfx gfx
fi
